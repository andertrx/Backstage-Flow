# Copie este arquivo para ".env" no servidor e preencha. NUNCA coloque o arquivo .env no GitHub nem mande por chat.
# Endereço do servidor (sem https://). Ex.: whats.backstageflow.com.br
DOMAIN=whats.seudominio.com.br
# Senha do banco do servidor (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Chave de acesso ao servidor (gere com: openssl rand -hex 24). É a mesma que você cola no CRM.
AUTHENTICATION_API_KEY=troque-por-uma-chave-forte
